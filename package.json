  },
  "homepage": "https://github.com/Terronex-dev/allo#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@terronex/engram": "^1.0.4",
    "@terronex/engram-trace-lite": "^0.1.0",
    "@xenova/transformers": "^2.17.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
